public class square {
    public static void main(String[] args)
    {
        int n=0,j;
        for(int i=1;i<=5;i++)
        {
             for(j=1;j<=5;j++)
             {
                 if(i == 1||i==5||j==1||j==5 )
               {
                    System.out.print("* ");
                    n++;
                }
                else
                {
                    System.out.print("  ");
                }
            }

            System.out.println();
        }
      
   System.out.println(n);
  }
          
}
